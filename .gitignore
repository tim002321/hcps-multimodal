# ============================================================
# 归档区：历史代码 / 数据 / 构建产物，约 10 GB，不进版本库
# ============================================================
_archive/

# ---- Python ----
__pycache__/
*.py[cod]

# ---- 虚拟环境与 IDE ----
.venv/
shifeiyuantwo/
.idea/
.vs/
*.iml

# ---- 构建产物 ----
build/
dist/

# ---- 运行时输出 ----
pic_save/
output/
输出/

# 采集数据：会话库 / 摄像头帧库 / JSONL 输出，单个可达数百 MB，不进版本库
# （代码会自己建库；需要样本数据请放进 data/samples/ 并单独加白名单）
AAAwindows_code/data/
AAAwindows_code/ecg_data.jsonl

# 自检/冒烟测试跑出来的结果库（任何层级的「实验结果」目录）
实验结果/

# 推理模型权重：单个 6~13MB，用 tools/vision/fetch_models.py 获取，不进版本库
AAAwindows_code/models/*.pt
AAAwindows_code/models/*.onnx
AAAwindows_code/models/*.part

# 工作记忆与自检截图（本地产物，不进版本库）
.workbuddy/
AAAwindows_code/ui_shots/

# ============================================================
# 本机分支追加：离线分析产物与大体积数据
# ============================================================
# 分离出来的信号库（9 个会话，2.1 GB）与分段结果（63 个 trial，1.0 GB）
信号库/
实验分段/

# 报告图集（92 张 PNG）与人工核对截图
图集/
视觉标签核对/

# 视觉对比实验：只留结论文档与逐帧 CSV，图片/PDF 不进库
视觉对比_20261118/**/*.png
视觉对比_20261118/**/*.jpg
视觉对比_20261118/**/*.pdf

# 根目录的启动截图与二进制报告
启动截图*.png
试飞院实验数据分析报告.docx

# 数据库临时文件
*.db-shm
*.db-wal

# 运行时采集日志（单文件可达 150 MB 以上）
ecg_data.jsonl
*.log
build_log.txt

# 视觉回填运行日志（本地产物）
视觉回填_*.txt

# ============================================================
# 眼动工具（eye_tool/）：只提交代码，运行产物不进库
# ============================================================
# out/ 是采集输出：截图、实时 CSV、错误日志、离线标注图，单次录制几十 MB
eye_tool/out/

# 界面里选的摄像头/分辨率（本机偏好，换电脑没意义）
eye_tool/out/camera_prefs.json
AAAwindows_code/data/camera_prefs.json
