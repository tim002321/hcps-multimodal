# ============================================================
# 归档区：历史代码 / 数据 / 构建产物，约 10 GB，不进版本库
# ============================================================
_archive/

# ---- Python ----
__pycache__/
*.py[cod]

# ---- 虚拟环境与 IDE ----
.venv/
.idea/
.vs/
*.iml

# ---- 构建产物 ----
build/
dist/

# ---- 运行时输出 ----
pic_save/

# 采集数据：会话库 / 摄像头帧库 / JSONL 输出，单个可达数百 MB，不进版本库
# （代码会自己建库；需要样本数据请放进 data/samples/ 并单独加白名单）
AAAwindows_code/data/
AAAwindows_code/ecg_data.jsonl

# 自检/冒烟测试跑出来的结果库（任何层级的「实验结果」目录）
实验结果/

# 推理模型权重：单个 6~13MB，用 tools/vision/fetch_models.py 获取，不进版本库
AAAwindows_code/models/*.pt
AAAwindows_code/models/*.onnx
AAAwindows_code/models/*.part

# 工作记忆与自检截图（本地产物，不进版本库）
.workbuddy/
AAAwindows_code/ui_shots/

